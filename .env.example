# Local GGUF model (only if using --provider local)
GROUNDANNOT_LLM=

# API keys — set only the providers you plan to use
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
SCALEWAY_API_KEY=
NVIDIA_API_KEY=
